[workspace]
[package]
name = "wire-published-composition-check"
version = "0.0.0"
edition = "2024"
publish = false
[features]
endpoint = ["ic-wire/endpoint"]
[dependencies]
ic-wire = { version = "=0.10.0", default-features = false, features = ["platform-types"] }
ic-platform = { version = "=0.11.1", default-features = false, features = ["principal"] }
serde = { version = "1", default-features = false, features = ["derive", "alloc"] }
[dev-dependencies]
serde_bytes = "0.11"
serde_json = "1"
