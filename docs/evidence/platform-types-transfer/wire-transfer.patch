index 0000000..6eb54c0
--- /dev/null
+++ b/crates/ic-wire/src/platform_types/mod.rs
@@ -0,0 +1,25 @@
+//! Metadata for Platform's owned identities; Platform's Serde implementations own bytes.
+// Transferred from IC Platform 421edbc's principal/account wire_schema modules.
+// Only ownership changes: Principal remains bounded bytes (max 29), and Account
+// keeps owner then Option<[u8; 32]>. No bytes, budgets or acceptance rules change.
+// Consumers replace Platform's wire-schema feature with Wire's platform-types.
+
+use crate::typescript::{GenerationError, SchemaContext, Wire};
+
+impl Wire for ic_platform::Principal {
+    fn native_schema(context: &mut SchemaContext) -> Result<serde_json::Value, GenerationError> {
+        context.describe::<crate::Bytes<{ Self::MAX_LENGTH_IN_BYTES }>>()
+    }
+}
+
+impl Wire for ic_platform::Account {
+    fn native_schema(context: &mut SchemaContext) -> Result<serde_json::Value, GenerationError> {
+        Ok(serde_json::json!({
+            "k": "record",
+            "fields": [
+                {"name": "owner", "value": context.describe::<ic_platform::Principal>()?},
+                {"name": "subaccount", "value": context.describe::<Option<ic_platform::Subaccount>>()?}
+            ]
+        }))
+    }
+}
diff --git a/crates/ic-wire-qualification/fixtures/platform_types/mod.rs b/crates/ic-wire-qualification/fixtures/platform_types/mod.rs
new file mode 100644
index 0000000..5b741f0
--- /dev/null
+++ b/crates/ic-wire-qualification/fixtures/platform_types/mod.rs
@@ -0,0 +1,270 @@
+//! Standalone consumer proof transferred from Platform commit 421edbc.
+use ic_platform::Principal;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, PartialEq, Serialize, Deserialize)]
+#[cfg_attr(not(target_family = "wasm"), derive(ic_wire::Wire))]
+pub struct Request {
+    pub caller: Principal,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[cfg_attr(not(target_family = "wasm"), derive(ic_wire::Wire))]
+pub struct AccountRequest {
+    pub account: ic_platform::Account,
+}
+
+#[cfg(feature = "endpoint")]
+#[ic_wire::endpoint::query(contract = ACCOUNT_CONTRACT)]
+pub fn echo_account(value: AccountRequest) -> AccountRequest {
+    value
+}
+
+#[cfg(all(test, not(target_family = "wasm")))]
+mod tests {
+    use super::*;
+    use ic_wire::{Limits, native, typescript};
+
+    const LIMITS: Limits = Limits {
+        bytes: 512,
+        allocation: 65536,
+        nodes: 1024,
+        depth: 16,
+    };
+
+    #[test]
+    fn owned_identities_implement_the_consumers_wire_trait() {
+        fn accepts<T: ic_wire::typescript::Wire>() {}
+        accepts::<ic_platform::Principal>();
+        accepts::<ic_platform::Account>();
+    }
+
+    #[test]
+    fn principal_schema_and_frames() {
+        assert_eq!(
+            typescript::native_schema::<Principal>().unwrap(),
+            serde_json::json!({"k": "bytes", "max": 29})
+        );
+        let schema = typescript::native_schema::<Request>().unwrap();
+        let mut vectors = Vec::new();
+        for raw in [vec![], vec![4], vec![0; 29], vec![255; 29]] {
+            let value = Request {
+                caller: Principal::from_slice(&raw),
+            };
+            let request = native::encode_request(17, &value, LIMITS).unwrap();
+            let response = native::encode_response(17, &value, LIMITS).unwrap();
+            // A one-field Serde struct has the same payload as its byte buffer.
+            assert_eq!(
+                request,
+                native::encode_request(17, serde_bytes::Bytes::new(&raw), LIMITS).unwrap()
+            );
+            assert_eq!(
+                native::decode_request::<Request>(17, &request, LIMITS).unwrap(),
+                value
+            );
+            assert_eq!(
+                native::decode_response::<Request>(17, &response, LIMITS).unwrap(),
+                value
+            );
+            vectors.push(serde_json::json!({"raw": raw, "request": request, "response": response}));
+        }
+        let mut invalid = Vec::new();
+        for length in [30, 31, 255] {
+            let raw = vec![0; length];
+            assert!(Principal::try_from_slice(&raw).is_err());
+            let request =
+                native::encode_request(17, serde_bytes::Bytes::new(&raw), LIMITS).unwrap();
+            let response =
+                native::encode_response(17, serde_bytes::Bytes::new(&raw), LIMITS).unwrap();
+            assert!(native::decode_request::<Request>(17, &request, LIMITS).is_err());
+            assert!(native::decode_response::<Request>(17, &response, LIMITS).is_err());
+            invalid.push(serde_json::json!({"raw": raw, "request": request, "response": response}));
+        }
+        if let Some(directory) = std::env::var_os("WIRE_PLATFORM_TYPES_OUTPUT") {
+            let directory = std::path::PathBuf::from(directory);
+            let method = serde_json::json!({
+                "name": "principal", "mode": "query", "id": "17", "request": schema,
+                "response": schema, "requestBytes": 512, "responseBytes": 512,
+                "requestNodes": 1024, "responseNodes": 1024, "requestDepth": 16, "responseDepth": 16
+            });
+            std::fs::write(
+                directory.join("principal.ts"),
+                typescript::generate_registry(
+                    &Default::default(),
+                    &[method],
+                    "./wire-runtime.js",
+                    &Default::default(),
+                    |report| eprint!("{report}"),
+                )
+                .unwrap(),
+            )
+            .unwrap();
+            std::fs::write(directory.join("wire-runtime.ts"), typescript::RUNTIME).unwrap();
+            std::fs::write(
+                directory.join("vectors.json"),
+                serde_json::to_vec(&serde_json::json!({
+                    "valid": vectors, "invalid": invalid
+                }))
+                .unwrap(),
+            )
+            .unwrap();
+        }
+    }
+
+    #[test]
+    fn account_schema_and_frames_preserve_representation() {
+        use ic_platform::Account;
+        assert_eq!(
+            typescript::native_schema::<Account>().unwrap(),
+            serde_json::json!({
+                "k": "record", "fields": [
+                    {"name": "owner", "value": {"k": "bytes", "max": 29}},
+                    {"name": "subaccount", "value": {"k": "option", "item": {
+                        "k": "array", "max": 32, "item": {"k": "u", "bits": 8}
+                    }}}
+                ]
+            })
+        );
+        let schema = typescript::native_schema::<AccountRequest>().unwrap();
+        let absent = Account::from(Principal::anonymous());
+        let zero = Account {
+            subaccount: Some([0; 32]),
+            ..absent
+        };
+        assert_eq!(absent, zero);
+        assert_ne!(
+            native::encode_request(18, &absent, LIMITS).unwrap(),
+            native::encode_request(18, &zero, LIMITS).unwrap()
+        );
+        let mut vectors = Vec::new();
+        for raw in [vec![], vec![4], vec![255; 29]] {
+            for subaccount in [None, Some([0; 32]), Some([255; 32])] {
+                let value = AccountRequest {
+                    account: Account {
+                        owner: Principal::from_slice(&raw),
+                        subaccount,
+                    },
+                };
+                let request = native::encode_request(18, &value, LIMITS).unwrap();
+                let response = native::encode_response(18, &value, LIMITS).unwrap();
+                // Compare against the pre-existing field encoding, not Account equality.
+                assert_eq!(
+                    request,
+                    native::encode_request(
+                        18,
+                        &(serde_bytes::Bytes::new(&raw), subaccount),
+                        LIMITS
+                    )
+                    .unwrap()
+                );
+                let decoded =
+                    native::decode_request::<AccountRequest>(18, &request, LIMITS).unwrap();
+                assert_eq!(decoded.account.owner, value.account.owner);
+                assert_eq!(decoded.account.subaccount, subaccount);
+                let decoded =
+                    native::decode_response::<AccountRequest>(18, &response, LIMITS).unwrap();
+                assert_eq!(decoded.account.subaccount, subaccount);
+                vectors.push(serde_json::json!({"owner": raw, "subaccount": subaccount,
+                "request": request, "response": response}));
+            }
+        }
+        if let Some(directory) = std::env::var_os("WIRE_PLATFORM_TYPES_OUTPUT") {
+            let directory = std::path::PathBuf::from(directory);
+            let method = serde_json::json!({
+                "name": "account", "mode": "query", "id": "18", "request": schema,
+                "response": schema, "requestBytes": 512, "responseBytes": 512,
+                "requestNodes": 1024, "responseNodes": 1024, "requestDepth": 16, "responseDepth": 16
+            });
+            std::fs::write(
+                directory.join("account.ts"),
+                typescript::generate_registry(
+                    &Default::default(),
+                    &[method],
+                    "./wire-runtime.js",
+                    &Default::default(),
+                    |report| eprint!("{report}"),
+                )
+                .unwrap(),
+            )
+            .unwrap();
+            std::fs::write(
+                directory.join("accounts.json"),
+                serde_json::to_vec(&vectors).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+
+    fn account_frames<T: Serialize>(value: &T) -> (Vec<u8>, Vec<u8>) {
+        (
+            native::encode_request(18, value, LIMITS).unwrap(),
+            native::encode_response(18, value, LIMITS).unwrap(),
+        )
+    }
+
+    #[test]
+    fn malformed_account_frames_are_refused() {
+        // Build malformed field layouts with the canonical encoder. The fixed-array
+        // subaccount has no length prefix; missing/extra elements must still refuse.
+        let owner = serde_bytes::Bytes::new(&[4]);
+        let valid = ic_platform::Account::from(Principal::anonymous());
+        let mut cases = vec![
+            (
+                "short subaccount",
+                account_frames(&(owner, 1_u8, [0_u8; 31])),
+            ),
+            (
+                "long subaccount",
+                account_frames(&(owner, 1_u8, [0_u8; 32], 0_u8)),
+            ),
+            ("invalid option tag", account_frames(&(owner, 2_u8))),
+            (
+                "oversized owner",
+                account_frames(&(serde_bytes::Bytes::new(&[0; 30]), None::<[u8; 32]>)),
+            ),
+            ("trailing bytes", account_frames(&(valid, 7_u8))),
+            (
+                "wrong method",
+                (
+                    native::encode_request(19, &valid, LIMITS).unwrap(),
+                    native::encode_response(19, &valid, LIMITS).unwrap(),
+                ),
+            ),
+        ];
+        let (request, response) = account_frames(&valid);
+        cases.push(("wrong direction", (response, request)));
+        let mut vectors = Vec::new();
+        for (name, (request, response)) in cases {
+            assert!(
+                native::decode_request::<AccountRequest>(18, &request, LIMITS).is_err(),
+                "{name}"
+            );
+            assert!(
+                native::decode_response::<AccountRequest>(18, &response, LIMITS).is_err(),
+                "{name}"
+            );
+            vectors
+                .push(serde_json::json!({"name": name, "request": request, "response": response}));
+        }
+        if let Some(directory) = std::env::var_os("WIRE_PLATFORM_TYPES_OUTPUT") {
+            std::fs::write(
+                std::path::PathBuf::from(directory).join("accounts-invalid.json"),
+                serde_json::to_vec(&vectors).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+
+    #[cfg(feature = "endpoint")]
+    #[test]
+    fn combined_endpoint_uses_the_same_schema_trait() {
+        assert_eq!(
+            ACCOUNT_CONTRACT.request_schema().unwrap(),
+            typescript::native_schema::<AccountRequest>().unwrap()
+        );
+        assert_eq!(
+            ACCOUNT_CONTRACT.response_schema().unwrap(),
+            typescript::native_schema::<AccountRequest>().unwrap()
+        );
+    }
+}
diff --git a/crates/ic-wire-qualification/fixtures/platform_types/check.mjs b/crates/ic-wire-qualification/fixtures/platform_types/check.mjs
new file mode 100644
index 0000000..1726e31
--- /dev/null
+++ b/crates/ic-wire-qualification/fixtures/platform_types/check.mjs
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { principal } from './principal.js';
+const vectors = JSON.parse(readFileSync(new URL('./vectors.json', import.meta.url)));
+for (const { raw, request, response } of vectors.valid) {
+  const value = { caller: Uint8Array.from(raw) };
+  assert.deepEqual([...principal.encodeRequest(value)], request);
+  assert.deepEqual([...principal.encodeResponse(value)], response);
+  assert.deepEqual(principal.decodeRequest(Uint8Array.from(request)).caller, value.caller);
+  assert.deepEqual(principal.decodeResponse(Uint8Array.from(response)).caller, value.caller);
+}
+for (const { raw, request, response } of vectors.invalid) {
+  const value = { caller: Uint8Array.from(raw) };
+  assert.throws(() => principal.encodeRequest(value));
+  assert.throws(() => principal.encodeResponse(value));
+  assert.throws(() => principal.decodeRequest(Uint8Array.from(request)));
+  assert.throws(() => principal.decodeResponse(Uint8Array.from(response)));
+}
+console.log('Principal Rust/TypeScript frames and length refusals passed');
+
+const { account } = await import('./account.js');
+const accounts = JSON.parse(readFileSync(new URL('./accounts.json', import.meta.url)));
+for (const { owner, subaccount, request, response } of accounts) {
+  const value = { account: {
+    owner: Uint8Array.from(owner),
+    subaccount: subaccount === null ? null : { some: subaccount },
+  } };
+  assert.deepEqual([...account.encodeRequest(value)], request);
+  assert.deepEqual([...account.encodeResponse(value)], response);
+  for (const decoded of [account.decodeRequest(Uint8Array.from(request)),
+                         account.decodeResponse(Uint8Array.from(response))]) {
+    assert.deepEqual(decoded.account.owner, value.account.owner);
+    if (subaccount === null) assert.equal(decoded.account.subaccount, null);
+    else assert.deepEqual(decoded.account.subaccount.some, subaccount);
+  }
+}
+for (const length of [0, 31, 33]) {
+  assert.throws(() => account.encodeRequest({ account: {
+    owner: new Uint8Array([4]), subaccount: { some: Array(length).fill(0) },
+  } }));
+}
+console.log('Account Rust/TypeScript frames preserve absent, zero and nonzero subaccounts');
+const invalidAccounts = JSON.parse(readFileSync(new URL('./accounts-invalid.json', import.meta.url)));
+for (const { name, request, response } of invalidAccounts) {
+  assert.throws(() => account.decodeRequest(Uint8Array.from(request)), name);
+  assert.throws(() => account.decodeResponse(Uint8Array.from(response)), name);
+}
+console.log('Account malformed request/response refusals agree with Rust');
diff --git a/scripts/ci/check-platform-types.sh b/scripts/ci/check-platform-types.sh
new file mode 100755
index 0000000..b0bb1e4
--- /dev/null
+++ b/scripts/ci/check-platform-types.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# Standalone schema/Serde consumer; explicit prepared Node/TypeScript, no installs.
+set -euo pipefail
+export RUSTUP_AUTO_INSTALL=0
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
+compiler="${1:-$root/examples/browser/node_modules/typescript/bin/tsc}"
+[[ -f "$compiler" ]] || { echo 'Prepare the browser TypeScript compiler first' >&2; exit 1; }
+compiler="$(cd "$(dirname "$compiler")" && pwd -P)/$(basename "$compiler")"
+node "$compiler" --version
+mkdir -p "$root/target"
+fixture="$(mktemp -d "$root/target/platform-types.XXXXXX")"
+printf 'Platform type qualification: %s\n' "$fixture"
+mkdir "$fixture/src" "$fixture/browser"
+cp "$root/crates/ic-wire-qualification/fixtures/platform_types/mod.rs" "$fixture/src/lib.rs"
+cp "$root/Cargo.lock" "$fixture/Cargo.lock"
+cargo metadata --manifest-path "$root/Cargo.toml" --locked --offline --format-version 1 > "$fixture/workspace.json"
+# Reuse the exact selected supplier; isolated pre-release qualification may use
+# a path source, but the normal consumer uses the selected registry release.
+node - "$root" "$fixture" <<'JS'
+const fs=require('node:fs'),path=require('node:path');
+const [root,fixture]=process.argv.slice(2),m=JSON.parse(fs.readFileSync(`${fixture}/workspace.json`));
+const wire=m.packages.find(p=>p.name==='ic-wire'&&p.manifest_path===`${root}/crates/ic-wire/Cargo.toml`);
+const dep=m.resolve.nodes.find(n=>n.id===wire.id).deps.find(d=>d.name==='ic_platform');
+const platform=m.packages.find(p=>p.id===dep.pkg);
+const source=platform.source===null?`, path = ${JSON.stringify(path.dirname(platform.manifest_path))}`:'';
+fs.writeFileSync(`${fixture}/Cargo.toml`, `[workspace]
+[package]
+name = "wire-platform-types-consumer"
+version = "0.0.0"
+edition = "2024"
+[features]
+endpoint = ["ic-wire/endpoint"]
+[dependencies]
+ic-wire = { path = ${JSON.stringify(`${root}/crates/ic-wire`)}, default-features = false, features = ["platform-types"] }
+ic-platform = { version = "=${platform.version}"${source}, default-features = false, features = ["principal"] }
+serde = { version = "1", default-features = false, features = ["derive", "alloc"] }
+[dev-dependencies]
+serde_bytes = "0.11"
+serde_json = "1"
+`);
+JS
+# Only this disposable consumer lock is reconciled; checks thereafter are locked.
+export CARGO_TARGET_DIR="$fixture/target"
+cargo metadata --manifest-path "$fixture/Cargo.toml" --offline --format-version 1 > "$fixture/metadata.json"
+for selection in types combined; do
+    options=(--manifest-path "$fixture/Cargo.toml" --locked --offline)
+    [[ "$selection" != combined ]] || options+=(--features endpoint)
+    for target in "$(rustc -vV | sed -n 's/^host: //p')" wasm32-unknown-unknown; do
+        graph="$fixture/$selection-$target.txt"
+        cargo tree "${options[@]}" --target "$target" --edges normal,build --prefix none --format '{p} features={f}' > "$graph"
+        if grep -Eq '^(candid|candid_parser|pocket-ic|ic-cdk|ic-cdk-executor|ic0) v' "$graph"; then
+            echo 'External codec/runtime dependency leaked into platform types' >&2; exit 1
+        fi
+        if [[ "$selection" == types ]]; then
+            if grep -Eq '^ic-platform-(macros|runtime-guard) v|^ic-platform v.*features=.*(cdk|executor|runtime|candid|wire-schema)' "$graph"; then
+                echo 'Schema-only consumer selected endpoint/runtime machinery' >&2; exit 1
+            fi
+        else
+            grep -Eq '^ic-platform-runtime-guard v' "$graph"
+            grep -Eq '^ic-platform-macros v' "$graph"
+        fi
+        if [[ "$target" == wasm32-unknown-unknown ]]; then
+            if grep -Eq '^serde_json v' "$graph"; then echo 'Host schema dependency leaked to Wasm' >&2; exit 1; fi
+        else
+            grep -Eq '^serde_json v' "$graph"
+        fi
+        cargo +1.91.0 check "${options[@]}" --target "$target"
+    done
+    WIRE_PLATFORM_TYPES_OUTPUT="$fixture/browser" cargo +1.91.0 test "${options[@]}" --lib
+    cargo clippy "${options[@]}" --all-targets -- -D warnings
+done
+for target in "$(rustc -vV | sed -n 's/^host: //p')" wasm32-unknown-unknown; do
+    cargo tree --manifest-path "$root/Cargo.toml" --locked --offline -p ic-wire --no-default-features --target "$target" --edges normal,build --prefix none > "$fixture/core-$target.txt"
+    if grep -Eq '^(ic-platform|serde_json|candid|pocket-ic) v' "$fixture/core-$target.txt"; then echo 'Optional integration leaked into core' >&2; exit 1; fi
+done
+printf '{"type":"module"}\n' > "$fixture/browser/package.json"
+node "$compiler" --ignoreConfig --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --target ES2022 --module NodeNext --moduleResolution NodeNext --outDir "$fixture/browser" "$fixture/browser/principal.ts" "$fixture/browser/account.ts" "$fixture/browser/wire-runtime.ts"
+cp "$root/crates/ic-wire-qualification/fixtures/platform_types/check.mjs" "$fixture/browser/check.mjs"
+node "$fixture/browser/check.mjs"
