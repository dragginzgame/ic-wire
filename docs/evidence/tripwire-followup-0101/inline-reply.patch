+#[test]
+fn inline_reply_parity_and_boundary() {
+    let limits = crate::Limits {
+        bytes: 4096,
+        allocation: 65536,
+        nodes: 1024,
+        depth: 16,
+    };
+    for length in 0..300 {
+        let value = crate::ByteBuf::from(alloc::vec![0xa5; length]);
+        let expected = super::encode_response(7, &value, limits).unwrap();
+        let actual = super::encode_inline_response(7, &value, limits).unwrap();
+        assert_eq!(actual.as_ref(), expected);
+        assert_eq!(
+            matches!(actual, super::InlineReply::Inline { .. }),
+            expected.len() <= 128
+        );
+        for bounded in [
+            crate::Limits {
+                bytes: expected.len() - 1,
+                ..limits
+            },
+            crate::Limits { nodes: 0, ..limits },
+            crate::Limits { depth: 0, ..limits },
+            crate::Limits {
+                allocation: 0,
+                ..limits
+            },
+        ] {
+            assert_eq!(
+                super::encode_inline_response(7, &value, bounded).err(),
+                super::encode_response(7, &value, bounded).err()
+            );
+        }
+    }
+}
