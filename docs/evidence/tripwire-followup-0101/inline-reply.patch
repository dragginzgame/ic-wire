+// Research only: replace output ownership, not encoding or admission. Both
+// branches size once, cap writes at that result and emit identical framed bytes.
+// The Platform experiment allows any owned AsRef<[u8]> encoder output.
+#[doc(hidden)]
+pub enum InlineReply {
+    Inline { bytes: [u8; 128], len: usize },
+    Heap(Vec<u8>),
+}
+impl AsRef<[u8]> for InlineReply {
+    fn as_ref(&self) -> &[u8] {
+        match self {
+            Self::Inline { bytes, len } => &bytes[..*len],
+            Self::Heap(bytes) => bytes,
+        }
+    }
+}
+pub(crate) fn encode_inline_response<T: Serialize + ?Sized>(
+    id: u64,
+    value: &T,
+    limits: Limits,
+) -> Result<InlineReply, Error> {
+    let prefix = contract::header(id, 1);
+    let size = encoded_len(value, payload_limits(limits, prefix.len())?)?;
+    let total = size + prefix.len();
+    let budget = Budget::new(limits);
+    let bounded = encode::Bounded {
+        value,
+        budget: &budget,
+        depth: 1,
+    };
+    if total <= 128 {
+        let mut bytes = [0; 128];
+        bytes[..prefix.len()].copy_from_slice(&prefix);
+        let written = postcard::to_slice(&bounded, &mut bytes[prefix.len()..total])
+            .map_err(|_| budget.error())?
+            .len()
+            + prefix.len();
+        Ok(InlineReply::Inline {
+            bytes,
+            len: written,
+        })
+    } else {
+        let mut bytes = Vec::new();
+        bytes
+            .try_reserve_exact(total)
+            .map_err(|_| Error::Allocation)?;
+        bytes.extend_from_slice(&prefix);
+        let bytes = postcard::serialize_with_flavor(
+            &bounded,
+            contract::Output {
+                bytes,
+                limit: total,
+            },
+        )
+        .map_err(|_| budget.error())?;
+        Ok(InlineReply::Heap(bytes))
+    }
+}
