+struct InlineOutput { reply: InlineReply, limit: usize }
+impl postcard::ser_flavors::Flavor for InlineOutput {
+    type Output = InlineReply;
+    #[inline(never)]
+    fn try_push(&mut self, byte: u8) -> postcard::Result<()> {
+        self.try_extend(&[byte])
+    }
+    #[inline(never)]
+    fn try_extend(&mut self, input: &[u8]) -> postcard::Result<()> {
+        let len = self.reply.as_ref().len();
+        if input.len() > self.limit - len { return Err(postcard::Error::SerializeBufferFull); }
+        match &mut self.reply {
+            InlineReply::Inline { bytes, len } => {
+                bytes[*len..*len+input.len()].copy_from_slice(input);
+                *len += input.len();
+            }
+            InlineReply::Heap(bytes) => bytes.extend_from_slice(input),
+        }
+        Ok(())
+    }
+    fn finalize(self) -> postcard::Result<Self::Output> { Ok(self.reply) }
+}
