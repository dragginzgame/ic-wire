[workspace]
[package]
name = "wire-deployment-consumer"
version = "0.0.0"
edition = "2024"
[features]
default = ["endpoint"]
endpoint = []
[dependencies]
ic-wire = { version = "=0.13.4", default-features = false, features = ["platform-types"] }
ic-wire-endpoint = { version = "=0.3.0", features = ["typescript"] }
ic-platform = { version = "=0.16.0", default-features = false, features = ["principal"] }
serde = { version = "1", default-features = false, features = ["derive", "alloc"] }
[dev-dependencies]
serde_bytes = "0.11"
serde_json = "1"
